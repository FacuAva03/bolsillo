rules_version = '2';

// Cada usuario solo puede leer y escribir dentro de usuarios/<su uid>/.
// Después de crear tu cuenta, cambiá TU_UID por tu UID (Authentication → Usuarios)
// en la línea de abajo, así nadie más puede usar la base aunque se cree una cuenta.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
        // && uid == 'TU_UID';
    }
  }
}
